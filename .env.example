# Copier ce fichier en « .env.local » (jamais envoyé sur GitHub) et le compléter.
# Les valeurs se trouvent dans Supabase : Project Settings → API Keys / Data API.

# Adresse du projet Supabase (ex. https://abcdefgh.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Clé « publishable » (commence par sb_publishable_) : utilisée par l'application.
# Elle ne donne accès à rien sans connexion grâce à la sécurité par ligne.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Clé « secret » (commence par sb_secret_) : UNIQUEMENT pour les scripts lancés
# sur le Mac (npm run db:seed, db:admin, db:verifier). Ne jamais la partager.
SUPABASE_SECRET_KEY=
